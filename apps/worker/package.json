{
  "name": "@agent-city/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "trigger dev",
    "deploy": "trigger deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "emit:test": "tsx --env-file-if-exists=../../.env scripts/emit-test-event.ts",
    "agents:sync": "tsx --env-file-if-exists=../../.env scripts/sync-agents.ts",
