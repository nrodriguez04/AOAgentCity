# Agent City environment (spec §11). Copy to .env for local scripts.
# Never commit real values. The city only needs the two NEXT_PUBLIC_ values.

# ---------------------------------------------------------------- city (browser)
# Put these in apps/city/.env.local for `pnpm city`, and in the Vercel project.
# Without them the city runs in demo mode with simulated data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------- worker (server only)
# Set these as Trigger.dev environment variables, and here for local scripts.

# Supabase Postgres via the Supavisor pooler (Project Settings -> Database ->
# Connection string). Server-side only: never ship it to the browser.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Anthropic
ANTHROPIC_API_KEY=
MODEL_REASONING=claude-opus-5-5
MODEL_STANDARD=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5
# Effort per tier (low | medium | high | xhigh | max). Defaults: high / medium / low.
# EFFORT_REASONING=high
# EFFORT_STANDARD=medium
# EFFORT_FAST=low
# Server-side refusal fallbacks are on for Opus/Sonnet. Set to "off" to disable.
# MODEL_FALLBACKS=off

# Trigger.dev
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Email sender for approved emails sent through Resend (per division overrides win).
EMAIL_FROM=ParlayLab <support@example.com>
# EMAIL_FROM_PARLAYLAB=ParlayLab Support <support@example.com>

# Integration credentials: prefer Supabase Vault, one secret per agent and integration:
#   select vault.create_secret('rk_live_...', 'agent:parlaylab.billing-01:stripe');
# Local-development fallback (AGENT_SECRET__<AGENT_ID>__<INTEGRATION>):
# AGENT_SECRET__PARLAYLAB_BILLING_01__STRIPE=rk_test_...
# AGENT_SECRET__PARLAYLAB_GROWTH_01__STRIPE=rk_test_...
# AGENT_SECRET__PARLAYLAB_SUPPORT_01__STRIPE=rk_test_...
# AGENT_SECRET__PARLAYLAB_BILLING_01__EMAIL=re_...
# AGENT_SECRET__PARLAYLAB_SUPPORT_01__GMAIL={"provider":"gmail","client_id":"...","client_secret":"...","refresh_token":"..."}

# Owner alerts (owner-alerts task, every 5 minutes): new approvals, failed runs and HQ's
# brief, emailed through Resend. Leave unset to turn alerts off. Contact details are masked.
ALERTS_RESEND_API_KEY=
ALERTS_EMAIL_TO=
# A sender on a domain verified in Resend. Falls back to EMAIL_FROM.
ALERTS_EMAIL_FROM=Agent City <alerts@example.com>
# Linked from every alert.
CITY_URL=

# Safety: true makes every run exit immediately (the "Pause city" button does the same).
AGENTS_PAUSED=false
